# 이 파일을 .env 로 복사한 뒤 값을 채워 사용함 (.env 는 git에 올라가지 않음)

# 외부에 공개되는 포트 (프론트 nginx). DB와 백엔드는 외부에 열리지 않음
HTTP_PORT=80

# DB 비밀번호 (필수)
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app

# 초기 관리자 (사원이 하나도 없을 때만 최초 기동 시 생성). 비밀번호를 비우면 임의 생성되어 백엔드 로그에 한 번만 출력됨
ADMIN_EMAIL=admin@dgjs.local
ADMIN_PASSWORD=

# HTTPS 로 서비스할 때만 true (HTTP 에서 true 이면 로그인 쿠키가 전달되지 않아 로그인이 안 됨)
SESSION_COOKIE_SECURE=false

# 브라우저가 접속하는 주소. nginx 가 같은 출처로 전달하므로 보통 영향 없음
CORS_ALLOWED_ORIGINS=http://localhost

# true 이면 /swagger-ui.html 공개 (인증 없이 열리므로 운영에서는 false 권장)
SWAGGER_ENABLED=false

# 백엔드 JVM 옵션 (메모리가 작은 서버에서 조정)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
